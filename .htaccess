DirectoryIndex index.html

# ---------------------------------------------
# Clean URLs: /about instead of /about.html
# ---------------------------------------------
RewriteEngine On

# 1. Redirect /index.html to the root: pihubng.com/
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# 2. Redirect /about.html to /about (old links and Google results keep working)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Quietly serve about.html when someone visits /about
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Force LiteSpeed to terminate HTTP/2 connection streams once sent
<IfModule mod_headers.c>
    Header set Connection "close"
</IfModule>

# Enable Gzip Compression (reduces transfers by up to 80%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets locally in visitors' browsers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>